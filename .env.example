# APEX Environment Configuration
# Local Paper-Research Only. No API Keys required for public market data.

APP_NAME=APEX
APP_ENV=development
APP_PORT=8000
FRONTEND_PORT=5173

# Device Configuration: 'auto', 'mps', or 'cpu'
INFERENCE_DEVICE=auto

# Model Selection: 'NeoQuasar/Kronos-mini' or 'NeoQuasar/Kronos-base'
DEFAULT_KRONOS_MODEL=NeoQuasar/Kronos-mini
DEFAULT_KRONOS_TOKENIZER=NeoQuasar/Kronos-Tokenizer-2k

# Cache directories (all local)
KRONOS_CACHE_DIR=./models_cache
DATABASE_PATH=./data/apex.db

# Market Data Settings
BINANCE_PUBLIC_REST_URL=https://api.binance.com
BINANCE_PUBLIC_WS_URL=wss://stream.binance.com:9443/ws
DEFAULT_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
